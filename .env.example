# ElevenLabs API Configuration (Get from https://elevenlabs.io/app/keys)
ELEVEN_LABS_API_KEY=sk_your_actual_key_here
ELEVEN_LABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ===== AI Assistant / Crop Doctor providers (edge functions) =====
# At least ONE is required or AI chat + crop scan will return a friendly
# "service unavailable" message. Providers are tried in this order:
#   1. GEMINI_API_KEY     — native Google Gemini (recommended, no proxy). Uses gemini-3.5-flash.
#   2. OPENAI_API_KEY     — any OpenAI-compatible endpoint
#   3. LOVABLE_API_KEY    — legacy Lovable AI gateway
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=sk-your_openai_key_here
LOVABLE_API_KEY=your_lovable_key_here

# Optional: Azure TTS fallback (Get from Azure Portal)
AZURE_SPEECH_KEY=your_azure_key_here
AZURE_SPEECH_REGION=centralindia

# OpenWeatherMap API key (Get from https://openweathermap.org/api)
# VITE_ prefix exposes it to the browser for direct client-side calls
VITE_OPEN_WEATHER_API_KEY=your_openweather_api_key_here
# Server-side (Supabase edge function) version, keep in sync with VITE_ one
OPEN_WEATHER_API_KEY=your_openweather_api_key_here

# Government Data API (data.gov.in) — Required for live Mandi prices
# Get from https://data.gov.in/ → My API Keys
GOVT_DATA_API_KEY=your_govt_data_api_key_here
# Client-side alias (used by some components)
VITE_MANDI_API_KEY=your_govt_data_api_key_here

# CORS Configuration (Domain whitelist for API security)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://bharatkrishi.com,https://www.bharatkrishi.com

# JWT signing secret. REQUIRED in production — the server refuses to start
# without it, because a hardcoded default would let anyone forge auth tokens.
JWT_SECRET=generate_a_long_random_string_here

# Google Analytics 4 + Tag Manager (SEO/analytics). Both are optional; the app
# skips loading the scripts entirely when these are unset, so dev builds never
# emit tracking requests. `dataLayer`/`gtag` events fire only for these.
VITE_GA4_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX
# Force-enable AnalyticsService event dispatch even in non-production builds.
VITE_ENABLE_ANALYTICS=false


# Optional: if set, the WhatsApp webhook only processes requests carrying this
# token (body.token or hub.verify_token), preventing anonymous OpenAI abuse.
WHATSAPP_WEBHOOK_TOKEN=

# ===== Supabase (core backend) =====
# Required for auth, store, tractor market, cattle listings, edge functions.
VITE_SUPABASE_PROJECT_ID=your_project_ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# ===== Data APIs =====
# Live agriculture news. AgriNews shows an error card when unset.
VITE_NEWS_API_KEY=your_newsapi_key
# Mapbox map token for StorageMap (https://account.mapbox.com/access-tokens/).
VITE_MAPBOX_TOKEN=your_mapbox_pk_token
# High-res agri imagery (https://www.pexels.com/api/).
VITE_PEXELS_API_KEY=your_pexels_key

# ===== Cloudinary (image upload / CDN) =====
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://...

# ===== Push notifications (Web Push / VAPID) =====
# Public VAPID key. Exposed to the browser; used by the client to create a
# PushManager subscription (src/hooks/usePushNotifications.tsx).
# Generate a pair with: npx web-push generate-vapid-keys
VITE_FIREBASE_VAPID_KEY=BBO_1Chhn1BHixmvBfSLdDiONscmef_8zM5jB6ufs9xPnBnDNs_kaaAI1Wo2_sSBX-kAI5mQcRWLgwqWdVpW3nU
# Private + public VAPID keys for the send-push-notification edge function.
VAPID_PRIVATE_KEY=Vb0yhoYsr4iTXLttAM_WcohOqSi8e4QOu-H5ckyjz1w
VAPID_PUBLIC_KEY=BBO_1Chhn1BHixmvBfSLdDiONscmef_8zM5jB6ufs9xPnBnDNs_kaaAI1Wo2_sSBX-kAI5mQcRWLgwqWdVpW3nU

# ===== Analytics (optional) =====
VITE_GA_PROPERTY=agric-62c00
VITE_GA_PROPERTY_ID=your_ga4_property_id
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Crash-logging endpoint (optional; unset = crash logging disabled).
VITE_CRASH_ENDPOINT=


# Razorpay (public key only — secret lives in server/.env)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
VITE_PAYMENT_BACKEND_URL=http://localhost:5000/api

# Resend Email Service (for OTP / welcome / notification emails)
RESEND_API_KEY=re_your_resend_key_here
EMAIL_FROM=AgriConnect <hello@yourdomain.com>