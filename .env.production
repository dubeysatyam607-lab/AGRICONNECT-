# Public Supabase configuration (NOT secrets — publishable key is designed for
# browser embedding; access is enforced by Row-Level Security in the database).
#
# Vite loads .env.production automatically for `npm run build`. This file is
# committed so ANY host (Netlify, GitHub Pages, Vercel, CI, ...) can build the
# app without dashboard-specific env setup. Without these the app crashed at
# startup with a blank/black screen ("supabaseUrl is required.").
VITE_SUPABASE_URL="https://yrebxnpilkfeaofykvhq.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_PMQ7FkMezMesBBJiVQsNUQ_Lu3I4n6A"

# Web3Forms — public form key (embedded in client forms by design).
# Sends contact, newsletter and callback-request submissions to the inbox.
VITE_WEB3FORMS_ACCESS_KEY="00673c97-2ad2-4e58-a488-7b6a40c43251"
