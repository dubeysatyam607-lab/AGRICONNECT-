# ─── Server (Express API) — AgriConnect Backend ──────────────────────────────
# Copy this file to server/.env and fill in real values. Never commit .env.

# App
PORT=5000
NODE_ENV=production
# Comma-separated allowed frontend origins, e.g. https://agriconnect.in
ALLOWED_ORIGINS=

# Auth
JWT_SECRET=change-me-to-a-long-random-secret

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password

# AI Chat
OPENAI_API_KEY=sk-...

# Voice / TTS
ELEVENLABS_API_KEY=...
# Alternate key name accepted by tts.js
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Azure TTS (optional; falls back to ElevenLabs)
AZURE_REGION=
AZURE_TTS_KEY=
AZURE_VOICE_NAME=hi-IN-MadhurNeural

# WhatsApp webhook
WHATSAPP_WEBHOOK_TOKEN=change-me

# Razorpay (server-side order creation + signature verification)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
