# ─── Server (Express API) — AgriConnect Backend ──────────────────────────────
# Copy this file to server/.env and fill in real values. Never commit .env.

# App
PORT=5000
NODE_ENV=production
# Comma-separated allowed frontend origins, e.g. https://agriconnect.in
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://bharatkrishi.com,https://www.bharatkrishi.com

# Auth
JWT_SECRET=change-me-to-a-long-random-secret

# Email (SMTP) — Used for OTP emails via Nodemailer
# Gmail: use App Password (not regular password) if 2FA enabled
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username@gmail.com
EMAIL_PASS=your-gmail-app-password

# Resend Email Service (alternative to SMTP, used by edge functions)
RESEND_API_KEY=re_your_resend_key_here
EMAIL_FROM=AgriConnect <hello@yourdomain.com>

# AI Chat / Crop Doctor — At least ONE required
# Get from: https://makersuite.google.com/app/apikey (Gemini)
# Get from: https://platform.openai.com/api-keys (OpenAI)
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=sk-your_openai_key_here
LOVABLE_API_KEY=your_lovable_key_here

# Voice / TTS
# ElevenLabs: https://elevenlabs.io/app/keys
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVEN_LABS_API_KEY=your_elevenlabs_key_here
ELEVEN_LABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Azure TTS (optional; falls back to ElevenLabs)
AZURE_REGION=centralindia
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_VOICE_NAME=hi-IN-MadhurNeural

# OpenWeatherMap (for weather edge function)
# Get from: https://openweathermap.org/api
OPEN_WEATHER_API_KEY=your_openweather_api_key_here

# Government Data API (data.gov.in) — Required for live Mandi prices
# Get from: https://data.gov.in/ → My API Keys
GOVT_DATA_API_KEY=your_govt_data_api_key_here

# News API (for AgriNews edge function)
# Get from: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# WhatsApp webhook
WHATSAPP_WEBHOOK_TOKEN=change-me-to-a-random-token

# Razorpay (server-side order creation + signature verification)
# Test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Supabase (for server-side admin operations if needed)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Push Notifications (VAPID) — Generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key